# Sculpture Trail Visitor Map — configuration
#
# Every setting below has a working in-code development default, so the app
# boots with no .env at all. Copy this file to .env to override anything.
# `install.sh` writes a .env with a generated SESSION_SECRET.

# Secret used to key session token digests. Leave empty to use the
# development fallback; install.sh generates a strong value into .env.
SESSION_SECRET=

# SQLite database file, relative to the project root. Created and seeded
# automatically on boot if it is missing.
SCULPTURE_DB_PATH=./trail.db

# HTTP port. The server always binds 0.0.0.0.
PORT=8000

# Set to true only when the app is served over HTTPS (marks the session
# cookie Secure). Leave false for local/preview HTTP.
SESSION_COOKIE_SECURE=false
